# Runtime
AGENT_MODE=demo
PORT=8000
STATE_DIR=./state
TRACE_DIR=./traces

# Payment provider mode
# mock: deterministic hackathon demo tools only
# sandbox: configured for DOKU MCP, with live remote MCP calls only when explicitly requested
PAYMENT_PROVIDER=mock
PAYMENT_API_MODE=mock
MESSAGING_MODE=mock

# DOKU MCP Server
# Docs: https://developers.doku.com/accept-payments/doku-mcp-server
# Sandbox endpoint: https://api-sandbox.doku.com/doku-mcp-server/mcp
# Production endpoint: https://mcp.doku.com/mcp
DOKU_MCP_URL=https://api-sandbox.doku.com/doku-mcp-server/mcp
DOKU_CLIENT_ID=
DOKU_API_KEY=
# Alternative to DOKU_API_KEY: set full header value, e.g. "Basic <base64(api_key:)>"
DOKU_AUTHORIZATION=

# Optional legacy/provider settings
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Optional messaging settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Safety
MAX_AUTONOMOUS_AMOUNT=10000
REQUIRE_HUMAN_APPROVAL=true
MAX_RETRIES=2

# Judge Mode public demo surface
# Give judges only the /judge URL and this non-DOKU demo token.
JUDGE_MODE=false
JUDGE_DEMO_TOKEN=
JUDGE_ALLOW_SANDBOX_WRITES=false
PUBLIC_DEMO_BASE_URL=

# LLM Reasoning Agent (multi-agent first stage)
# Any OpenAI-compatible /chat/completions endpoint works. When LLM_API_BASE
# and LLM_API_KEY are set the runtime uses the LLM Reasoning Agent and records
# its output in every trace. When unset, the reasoner falls back deterministically.
# Examples:
#   OpenAI:     https://api.openai.com/v1
#   9router:    http://127.0.0.1:20128/v1
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=8
